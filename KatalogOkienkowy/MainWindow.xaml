<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="1000">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Katalog"
                   FontSize="25"
                   FontWeight="Bold"/>

        <Button Grid.Row="0" Grid.Column="1"
                Content="Reload" Width="100"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Pojawia lista produktuw"
                   FontSize="18"
                   Margin="0,10,0,0"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal" Margin="0,10,10,0">
                <TextBlock Text="Liczba produktuw: "
                       FontSize="14" />

                <TextBlock x:Name="LiczbaProuktuw"
                       Text="0" FontSize="14" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Wartość magazynu: "
                       FontSize="14" />

                <TextBlock x:Name="WartoscMagazynu"
                       Text="0" FontSize="14" />
            </StackPanel>

            <Button Content="Dodaj" Width="100" Margin="10,10,10,0"/>
            <Button Content="Usun" Width="100" Margin="0,10,10,0"/>
            <Button Content="Zamknij" Width="100" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
