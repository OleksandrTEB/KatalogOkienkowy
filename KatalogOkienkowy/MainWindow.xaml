<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="1000">
    <StackPanel Margin="20" x:Name="GluwnyStekPanel">
        <TextBlock Text="Text Blok"
                   FontSize="25"/>
        <TextBlock x:Name="LiczbaProuktuw"
                   FontSize="14"
                   Margin="0,10,0,0"/>

        <TextBlock x:Name="WartoscMagazynu"
                   FontSize="14"
                   Margin="0,10,0,0"/>

        <Button Width="120">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/images.jpg" Width="20"/>
                <TextBlock Text="Dodaj produkt"
                       FontSize="14"
                       FontWeight="Bold"/>
            </StackPanel>
        </Button>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="Przycisk 1" Margin="5"/>
            <Button Grid.Row="0" Grid.Column="1" Content="Przycisk 1" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="0" Content="Przycisk 1" Margin="5"/>
            <Button Grid.Row="1" Grid.Column="1" Content="Przycisk 1" Margin="5"/>
        </Grid>
    </StackPanel>
</Window>
