<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy"
        mc:Ignorable="d"
        Title="Katalog Okienkowy" Height="600" Width="1000">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Katalog"
                   FontSize="25"
                   FontWeight="Bold"/>

        <Button Grid.Row="0" Grid.Column="1"
                Content="Reload"
                Width="100"
                Margin="10"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Pojawia lista produktuw"
                   FontSize="18"
                   Margin="0,10,0,0"/>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Nazwa produktu:"
                VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0 10" x:Name="Nazwa"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Cena:"
                       VerticalAlignment="Center" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0 10"
                VerticalAlignment="Center"
                 x:Name="Cena"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kategoria:" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0 10" x:Name="Combo">
                <ComboBoxItem Content="kategoria 1" />
                <ComboBoxItem Content="kategoria 2" />
                <ComboBoxItem Content="kategoria 3" />
                <ComboBoxItem Content="kategoria 4" />
                <ComboBoxItem Content="kategoria 5" />
            </ComboBox>

            <CheckBox
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Content="Produkt dostempny"
                Margin="0 10"
                x:Name="Gostemp"/>

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="Dodaj"/>
        </Grid>


        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,10,10,0">
                        <TextBlock Text="Liczba produktuw: "
                           FontSize="14" />

                        <TextBlock x:Name="LiczbaProuktuw"
                           Text="0" FontSize="14" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
                        <TextBlock Text="Wartość magazynu: "
                           FontSize="14" />

                        <TextBlock x:Name="WartoscMagazynu"
                           Text="0" FontSize="14" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <Button
                    Content="Usun"
                    Width="100"
                    Margin="0,10,10,0"/>
                <Button
                    Content="Zamknij"
                    Width="100"
                    Margin="0,10,0,0"/>
            </StackPanel>


        </Grid>
        <!--
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center">


        </StackPanel> -->
    </Grid>
